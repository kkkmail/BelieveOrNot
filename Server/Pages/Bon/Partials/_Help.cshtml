@model BonViewModel
<div id="help-content" hx-swap-oob="true">
    <details>
        <summary>Game Rules</summary>
        <div class="help-text">
            <p><strong>Believe Or Not</strong> is a bluffing card game.</p>
            <ul>
                <li>The first player plays 1–3 cards face down and declares a rank (e.g. "Kings").</li>
                <li>Subsequent players also play 1–3 cards face down, claiming the same rank.</li>
                <li>Any player can challenge the previous player's cards by picking one card to reveal.</li>
                <li>If the revealed card matches the declared rank — the challenger collects all table cards.</li>
                <li>If it does not match — the challenged player collects all table cards.</li>
                <li>The round ends when a player runs out of cards. That player wins the round.</li>
                <li>Scores: winners get a bonus, losers lose points per remaining card (jokers cost triple).</li>
            </ul>
        </div>
    </details>
</div>
