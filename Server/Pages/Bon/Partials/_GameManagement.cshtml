@model BonViewModel
<div id="game-management" hx-swap-oob="true">
    @if (Model.IsCreator && Model.State.MatchId != Guid.Empty)
    {
        <div class="management-buttons">
            @if (Model.State.Phase == GamePhase.WaitingForPlayers)
            {
                <button class="btn btn--start"
                        hx-post="/bon/start-round"
                        hx-vals='{"matchId": "@Model.State.MatchId"}'
                        hx-swap="none">
                    Start Round
                </button>
            }
            @if (Model.State.Phase == GamePhase.InProgress)
            {
                <button class="btn btn--danger"
                        hx-post="/bon/end-round"
                        hx-vals='{"matchId": "@Model.State.MatchId"}'
                        hx-swap="none"
                        hx-confirm="End this round without scoring?">
                    End Round
                </button>
            }
            @if (Model.State.Phase == GamePhase.WaitingForPlayers || Model.State.Phase == GamePhase.RoundEnd)
            {
                <button class="btn btn--danger"
                        hx-post="/bon/end-game"
                        hx-vals='{"matchId": "@Model.State.MatchId"}'
                        hx-swap="none"
                        hx-confirm="End the game and calculate final scores?">
                    End Game
                </button>
            }
        </div>
    }
</div>
