@model BonViewModel
<div id="card-pile" hx-swap-oob="true">
    @if (Model.State.MatchId != Guid.Empty)
    {
        <div class="table-pile-section">
            <span class="pile-label">Card Pile</span>
            <div class="card-pile-container">
                @if (Model.State.TablePileCount > 0)
                {
                    <span class="pile-visual">🂠</span>
                }
            </div>
            <span class="pile-count">@Model.State.TablePileCount cards</span>
        </div>
    }
</div>
