@model BonViewModel
<div id="card-pile" hx-swap-oob="true">
    @if (Model.State.MatchId != Guid.Empty)
    {
        <div class="table-pile-section">
            <span class="pile-label">Card Pile</span>
            <div class="card-pile-container">
                @if (Model.State.TablePileCount > 0)
                {
                    var displayCount = Math.Min(Model.State.TablePileCount, 15);
                    var spacing = displayCount <= 5 ? 8 : (displayCount <= 10 ? 5 : 3);
                    <div class="card-pile-stack" style="width: @(60 + (displayCount - 1) * spacing)px">
                        @for (int i = 0; i < displayCount; i++)
                        {
                            <div class="card-back" style="left: @(i * spacing)px"></div>
                        }
                    </div>
                }
                else
                {
                    <span class="pile-empty">Empty</span>
                }
            </div>
            <span class="pile-count">@Model.State.TablePileCount cards</span>
        </div>
    }
</div>
