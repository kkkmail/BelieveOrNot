@model BonViewModel
<div id="score-table" hx-swap-oob="true">
    @if (Model.State.Players.Count > 0)
    {
        <h3>Scores</h3>
        <table class="score-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.State.Players.OrderByDescending(p => p.Score))
                {
                    <tr class="@(player.Id == Model.YourPlayerId ? "score-row--you" : "")">
                        <td>@player.Name</td>
                        <td>@player.Score</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
