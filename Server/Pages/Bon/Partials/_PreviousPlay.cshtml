@model BonViewModel
<div id="previous-play" hx-swap-oob="true">
    @if (Model.State.MatchId != Guid.Empty)
    {
        <div class="previous-play-section">
            <span class="play-label">Last Play</span>
            @if (Model.State.LastPlayCardCount > 0)
            {
                var lastPlayerName = Model.State.LastActualPlayerIndex.HasValue
                    && Model.State.LastActualPlayerIndex.Value < Model.State.Players.Count
                    ? Model.State.Players[Model.State.LastActualPlayerIndex.Value].Name
                    : "Unknown";
                <div class="previous-play-cards">
                    @for (int i = 0; i < Model.State.LastPlayCardCount; i++)
                    {
                        <label class="card card--facedown">
                            <input type="radio" name="challengePickIndex" value="@i"
                                   @(Model.CanChallenge ? "" : "disabled") />
                            <span class="card-face">
                                <span class="card-rank">?</span>
                                <span class="card-suit">@Model.State.AnnouncedRank</span>
                            </span>
                        </label>
                    }
                </div>
                <span class="play-info">@lastPlayerName played @Model.State.LastPlayCardCount card(s) as @Model.State.AnnouncedRank</span>
            }
            else
            {
                <div class="previous-play-cards"></div>
                <span class="play-info">No previous play</span>
            }
        </div>
    }
</div>
