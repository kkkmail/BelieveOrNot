@model KingViewModel
@{
    var hand = Model.State.YourHand ?? new List<Card>();

    // Sort: Jokers first, then by rank (2→A), then by suit (S, C, D, H) — matches Bon
    var rankOrder = new Dictionary<string, int>
    {
        ["2"] = 0, ["3"] = 1, ["4"] = 2, ["5"] = 3, ["6"] = 4,
        ["7"] = 5, ["8"] = 6, ["9"] = 7, ["10"] = 8,
        ["J"] = 9, ["Q"] = 10, ["K"] = 11, ["A"] = 12
    };
    var suitOrder = new Dictionary<string, int>
    {
        ["Spades"] = 0, ["Clubs"] = 1, ["Diamonds"] = 2, ["Hearts"] = 3
    };

    var sortedHand = hand
        .Select((card, idx) => new { card, idx })
        .OrderBy(x => x.card.IsJoker ? 0 : 1)
        .ThenBy(x => rankOrder.GetValueOrDefault(x.card.Rank, -1))
        .ThenBy(x => suitOrder.GetValueOrDefault(x.card.Suit, 99))
        .ToList();

    var selectableSuits = Model.SelectableSuits;
}
<div id="king-hand" hx-swap-oob="true"
     @if (Model.CanPlay) {<text>data-max-select="1"</text>}
     @if (selectableSuits != null && Model.CanPlay) {<text> data-selectable-suits="@selectableSuits"</text>}>
    @if (hand.Count > 0 && Model.State.Phase == GamePhase.InProgress)
    {
        <h3>Your Hand (@hand.Count cards)</h3>
        <div class="hand">
            @foreach (var item in sortedHand)
            {
                var card = item.card;
                var suitClass = card.Suit.ToLower();
                var suitSymbol = card.Suit switch
                {
                    "Hearts" => "\u2665",
                    "Diamonds" => "\u2666",
                    "Clubs" => "\u2663",
                    "Spades" => "\u2660",
                    _ => ""
                };
                <label class="card card--@suitClass" data-rank="@card.Rank" data-suit="@card.Suit">
                    <input type="radio" name="kingCardSelect"
                           data-card-rank="@card.Rank" data-card-suit="@card.Suit"
                           @(Model.CanPlay ? "" : "disabled") />
                    <span class="card-face">
                        <span class="card-rank">@card.Rank</span>
                        <span class="card-suit">@suitSymbol</span>
                    </span>
                </label>
            }
        </div>
        <div id="king-card-order"></div>
    }
    else if (Model.State.MatchId != Guid.Empty)
    {
        <h3>Your Hand (0 cards)</h3>
    }
</div>
