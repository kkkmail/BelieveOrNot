@model KingViewModel
<div id="king-players" hx-swap-oob="true">
    @if (Model.State.MatchId != Guid.Empty)
    {
        @for (int pos = 0; pos < 4; pos++)
        {
            var player = pos < Model.State.Players.Count ? Model.State.Players[pos] : null;
            var isCurrent = pos == Model.State.CurrentPlayerIndex && Model.State.Phase == GamePhase.InProgress;
            var isYou = player != null && player.Id == Model.YourPlayerId;
            var isCreator = pos == 0 && player != null;
            var posClass = pos switch { 0 => "top", 1 => "right", 2 => "bottom", 3 => "left", _ => "" };

            <div class="king-player-pos king-player-pos--@posClass @(isCurrent ? "current-turn" : "") @(player != null && !player.IsConnected ? "player-card--disconnected" : "")">
                @if (player != null)
                {
                    <div class="king-player-name">
                        @player.Name
                        @if (isYou) { <text> &#128100;</text> }
                        @if (isCreator) { <text> &#11088;</text> }
                    </div>
                    <div class="king-player-stats">
                        <span>Cards: @player.HandCount</span>
                        <span>Tricks: @player.TricksWon</span>
                        <span>Score: @player.Score</span>
                        @if (!player.IsConnected) { <span class="badge badge--offline">offline</span> }
                    </div>
                }
                else
                {
                    <div class="king-player-name">Waiting...</div>
                    <div class="king-player-stats">
                        <span>Cards: 0</span>
                        <span>Tricks: 0</span>
                        <span>Score: 0</span>
                    </div>
                }
            </div>
        }
    }
</div>
