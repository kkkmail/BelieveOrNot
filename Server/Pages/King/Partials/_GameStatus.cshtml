@model KingViewModel
<div id="king-game-status" hx-swap-oob="true">
    @if (Model.State.MatchId != Guid.Empty)
    {
        var phaseText = Model.State.Phase switch
        {
            GamePhase.WaitingForPlayers => "Waiting for Players",
            GamePhase.InProgress => Model.State.WaitingForTrumpSelection ? "Selecting Trump Suit" : "Round in Progress",
            GamePhase.RoundEnd => "Round Ended",
            GamePhase.GameEnd => "Game Over",
            _ => Model.State.Phase.ToString()
        };
        var round = Model.State.CurrentRound;
        <div class="game-status">
            <h2>@phaseText</h2>
            <div class="status-info">
                @if (round != null)
                {
                    <span>Round: <strong>@(Model.State.CurrentRoundIndex + 1)</strong> &mdash; @round.Name</span>
                    <span>Phase: <strong>@(round.IsCollectingPhase ? "Collecting" : "Avoiding")</strong></span>
                }
                else
                {
                    <span>Round: <strong>@(Model.State.CurrentRoundIndex + 1)</strong></span>
                }
                <span>Turn: <strong>@(Model.CurrentPlayerName ?? "---")</strong></span>
                @if (Model.State.Phase == GamePhase.InProgress)
                {
                    <span>Tricks: <strong>@Model.State.CompletedTricks.Count / 8</strong></span>
                }
                <span class="match-id-section">
                    Match ID:
                    <code>@Model.State.MatchId</code>
                    <button type="button" class="btn-copy"
                            onclick="navigator.clipboard.writeText('@Model.State.MatchId').then(()=>{this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',1500)})">Copy</button>
                </span>
            </div>
        </div>
    }
</div>
