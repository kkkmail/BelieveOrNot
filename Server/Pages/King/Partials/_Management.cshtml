@model KingViewModel
<div id="king-management" hx-swap-oob="true">@if (Model.IsCreator && Model.State.MatchId != Guid.Empty
    && Model.State.Players.Count == 4
    && (Model.State.Phase == GamePhase.WaitingForPlayers || Model.State.Phase == GamePhase.RoundEnd))
{
    <div class="game-management">
        <button class="btn btn--start"
                hx-post="/king/start-round"
                hx-vals='{"matchId": "@Model.State.MatchId"}'
                hx-swap="none">
            Start Round
        </button>
    </div>
}</div>
